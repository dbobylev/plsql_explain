ORACLE_DSN=host:port/service_name
ORACLE_USER=user
ORACLE_PASSWORD=password
# Required for Cyrillic text in thick mode (Oracle Instant Client):
NLS_LANG=.AL32UTF8
SQLITE_PATH=./data/plsql.db
PLSQL_PARSER_PATH=./plsql_parser/bin/Release/net8.0/PlsqlParser
PARSER_TIMEOUT_SECONDS=600
LLM_BASE_URL=http://corporate-llm/v1
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4o
EMBEDDING_BASE_URL=http://corporate-embedding/v1
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
